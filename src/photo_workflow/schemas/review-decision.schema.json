{
  "$defs": {
    "ReviewScope": {
      "additionalProperties": false,
      "properties": {
        "cohort_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Cohort Ids",
          "type": "array"
        },
        "cohort_rule_version": {
          "const": "1",
          "default": "1",
          "title": "Cohort Rule Version",
          "type": "string"
        },
        "coordinate_contract_version": {
          "const": "1",
          "default": "1",
          "title": "Coordinate Contract Version",
          "type": "string"
        },
        "coordinate_spaces": {
          "items": {
            "enum": [
              "raw_sensor",
              "active_sensor",
              "decoded_detection",
              "preview"
            ],
            "type": "string"
          },
          "title": "Coordinate Spaces",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "cohort_ids",
        "coordinate_spaces"
      ],
      "title": "ReviewScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checkpoint": {
      "enum": [
        "cohort-rules",
        "coordinate-contract"
      ],
      "title": "Checkpoint",
      "type": "string"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ],
      "title": "Decision",
      "type": "string"
    },
    "input_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "title": "Input Hashes",
      "type": "object"
    },
    "packet_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Packet Sha256",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "reviewer": {
      "minLength": 1,
      "title": "Reviewer",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/ReviewScope"
    },
    "supersedes_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Sha256"
    },
    "timestamp_utc": {
      "format": "date-time",
      "title": "Timestamp Utc",
      "type": "string"
    }
  },
  "required": [
    "checkpoint",
    "reviewer",
    "decision",
    "timestamp_utc",
    "input_hashes",
    "reason",
    "run_id",
    "packet_sha256",
    "scope"
  ],
  "title": "ReviewDecision",
  "type": "object"
}
