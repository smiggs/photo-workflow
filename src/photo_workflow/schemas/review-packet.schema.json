{
  "$defs": {
    "ReviewScope": {
      "additionalProperties": false,
      "properties": {
        "cohort_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Cohort Ids",
          "type": "array"
        },
        "cohort_rule_version": {
          "const": "1",
          "default": "1",
          "title": "Cohort Rule Version",
          "type": "string"
        },
        "coordinate_contract_version": {
          "const": "1",
          "default": "1",
          "title": "Coordinate Contract Version",
          "type": "string"
        },
        "coordinate_spaces": {
          "items": {
            "enum": [
              "raw_sensor",
              "active_sensor",
              "decoded_detection",
              "preview"
            ],
            "type": "string"
          },
          "title": "Coordinate Spaces",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "cohort_ids",
        "coordinate_spaces"
      ],
      "title": "ReviewScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "camera_coverage": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Camera Coverage",
      "type": "array"
    },
    "checkpoint": {
      "enum": [
        "cohort-rules",
        "coordinate-contract"
      ],
      "title": "Checkpoint",
      "type": "string"
    },
    "evidence_paths": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Paths",
      "type": "array"
    },
    "input_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Input Hashes",
      "type": "object"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "run_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "$ref": "#/$defs/ReviewScope"
    }
  },
  "required": [
    "run_id",
    "checkpoint",
    "scope",
    "input_hashes",
    "evidence_paths",
    "camera_coverage",
    "blockers",
    "limitations"
  ],
  "title": "ReviewPacket",
  "type": "object"
}
