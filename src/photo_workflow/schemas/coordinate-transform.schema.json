      "type": "string"
    },
    "mask_resampling": {
      "const": "nearest",
      "default": "nearest",
      "title": "Mask Resampling",
      "type": "string"
    },
    "matrix": {
      "anyOf": [
        {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Matrix"
    },
    "max_error_px": {
      "default": 1e-06,
      "minimum": 0,
      "title": "Max Error Px",
      "type": "number"
    },
    "rounding": {
      "const": "nearest_half_up",
      "default": "nearest_half_up",
      "title": "Rounding",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_domain": {
      "$ref": "#/$defs/Rectangle"
    },
    "source_space": {
      "$ref": "#/$defs/CoordinateSpace"
    },
    "target_domain": {
      "$ref": "#/$defs/Rectangle"
    },
    "target_space": {
      "$ref": "#/$defs/CoordinateSpace"
    },
    "unsupported_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unsupported Reason"
    }
